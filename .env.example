# 복사해서 .env로 사용 (.env는 커밋하지 않는다)
# docker compose가 이 값을 읽는다. Spring은 같은 이름의 환경 변수를 읽고, 없으면 application.yml 기본값을 쓴다.

DB_PORT=3306
DB_NAME=mealfit
DB_USERNAME=mealfit
DB_PASSWORD=mealfit
DB_ROOT_PASSWORD=root

# 공유/배포 서버에서는 반드시 교체: openssl rand -base64 48
# JWT_SECRET=

# Python AI 서비스 주소 (Gemini 키는 AI 서비스 쪽 .env에만 둔다)
AI_SERVICE_URL=http://localhost:8000
