# 운영 서버(EC2)용. 서버에서 cp .env.prod.example .env 후 값을 채운다. 이 파일에는 실제 값을 넣지 않는다.
# 비밀번호 생성: openssl rand -base64 24

DB_NAME=mealfit
DB_USERNAME=mealfit
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 127.0.0.1 = 서버 내부에서만 DB 접속 (DBeaver는 SSH 터널 사용)
# 0.0.0.0   = 외부에서 3306 직접 접속 (EC2 보안 그룹에서 팀원 IP만 허용할 것)
DB_BIND=127.0.0.1

# ai-service가 아직 없으면 그대로 둔다 → 호출 실패 시 로컬 대체 식단으로 동작
AI_SERVICE_URL=http://ai-service:8000

# ai-service 추가 시 사용. Gemini 키는 이 서버 .env에만 둔다
# GEMINI_API_KEY=
